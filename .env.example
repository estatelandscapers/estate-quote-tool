# Copy this file to .env and adjust as needed. All values are optional — sensible
# defaults are used if unset.

# Port the server listens on
PORT=3000

# Where the SQLite database file lives. Must be on a persistent disk in production
# (see README "Deployment" section) — do NOT use this on serverless platforms.
DATA_DIR=./data

# Machine-to-machine key for the Site Management Tool (long random string).
# Unset = the /api/service namespace answers 503 and nothing is exposed.
SERVICE_API_KEY=
